@page "/"
@page "/signin"
@using CoreAdminWeb.Services
@using CoreAdminWeb.Services.Users
@layout CoreAdminWeb.Shared.Layout.AuthLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject AlertService AlertService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime


<style>
    body {
        font-family: "Segoe UI", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
    }
    
    .login-container {
        backdrop-filter: blur(18px);
        background: rgba(255, 255, 255, 0.25);
        border-radius: 20px;
        padding: 35px;
        width: 440px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.3);
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .login-container img {
        max-height: 80px;
        margin: auto;
        border-radius: 20px;
    }
    .subtitle {
        font-size: 16px;
        color: #f0fff5;
        font-weight: 800;
        text-shadow: 0 1px 4px rgba(0,0,0,1);
        margin: 20px 0;
    }


    .form-group {
        position: relative;
        margin-bottom: 20px;
    }

    .form-group input {
        width: 100%;
        padding: 12px 45px 12px 15px; /* Giữ icon bên phải */
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.4);
        background: rgba(255, 255, 255, 0.85);
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: 0.3s;
    }

    .form-group input:focus {
        border-color: #00b894;
        box-shadow: 0 0 6px rgba(0,184,148,0.5);
    }

    .form-group i {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #555;
        font-size: 16px;
        pointer-events: none;
    }

    .login-container button {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        background: linear-gradient(135deg, #00b894, #009688);
        color: #fff;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
   .login-container  button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 150, 136, 0.4);
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="mx-auto login-container">
    <img src="assets/images/quoc_huy.png" alt="Logo">
    <div class="subtitle">CƠ SỞ DỮ LIỆU QUẢN LÝ CHẤT LƯỢNG</div>
        <EditForm Model="this" OnValidSubmit="HandleGraphQLSignIn">
            <div class="form-group">
                    <InputText @bind-Value="_email" placeholder="Địa chỉ email" class="form-input" />
                </div>
            <div class="form-group">
                    <InputText @bind-Value="_password" placeholder="Mật khẩu" type="password" class="form-input" />
                </div>
                <button type="submit" class="btn w-full py-3.5 text-base bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] project-color project-text-color">
                    @if (isLoading)
                    {
                        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="inline-block h-5 w-5 animate-[spin_2s_linear_infinite] align-middle">
                            <line x1="12" y1="2" x2="12" y2="6"></line>
                            <line x1="12" y1="18" x2="12" y2="22"></line>
                            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
                            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
                            <line x1="2" y1="12" x2="6" y2="12"></line>
                            <line x1="18" y1="12" x2="22" y2="12"></line>
                            <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
                            <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                        </svg>
                    }
                    Đăng nhập
                </button>
        </EditForm>
</div>

<script>
    // Listen for Enter key and trigger a custom event
    window.listenForEnterKey = function (elementId, dotNetRef, methodName) {
        const handler = function (event) {
            if (event.key === "Enter") {
                dotNetRef.invokeMethodAsync(methodName);
            }
        };
        const el = elementId ? document.getElementById(elementId) : document;
        el.addEventListener('keydown', handler);

        // Return a cleanup function
        return {
            dispose: () => el.removeEventListener('keydown', handler)
        };
    };
</script>

<!-- End Main Content -->
@code {
    private string _email { get; set; } = string.Empty;
    private string _password { get; set; } = string.Empty;
    private bool isLoading = false;
    private DotNetObjectReference<Signin>? _dotNetRef;
    private IJSObjectReference? _jsListener;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _jsListener = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "listenForEnterKey",
                null, // Không truyền elementId => lắng nghe trên document
                _dotNetRef,
                nameof(OnEnterPressed)
            );
        }
    }

    [JSInvokable]
    public async Task OnEnterPressed()
    {
        await HandleGraphQLSignIn();
    }
    private async Task HandleGraphQLSignIn()
    {
        if (string.IsNullOrEmpty(_password) || string.IsNullOrEmpty(_email))
            return;

        isLoading = true;
        StateHasChanged();
        var response = await UserService.LoginAsync(_email, _password);
        if (response.IsSuccess)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                AlertService.ShowAlert("Đăng nhập thành công!", "success");

                try
                {
                    if (_jsListener != null)
                    {
                        await _jsListener.InvokeVoidAsync("dispose");
                        await _jsListener.DisposeAsync();
                    }
                    _dotNetRef?.Dispose();
                }
                catch (Exception jsEx)
                {
                    Console.WriteLine($"Error disposing JS listener: {jsEx.Message}");
                }

                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                AlertService.ShowAlert("Chưa đăng nhập thành công!", "warning");
                Navigation.NavigateTo("/");
            }
        }
        else
        {
            AlertService.ShowAlert(response.Message ?? "Lỗi khi đăng nhập", "danger");
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleGraphQLSignIn();
        }
    }
}

