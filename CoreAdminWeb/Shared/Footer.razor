<!-- Start Footer -->
<footer class="py-2 text-center text-black dark:text-darkmuted">
    <div class="flex @(IsCenter ? "justify-center" : "justify-between") items-center">
        <!-- Left Side -->
        <div class="text-left">
            &copy; <span>@FullYear</span> Cơ sở dữ liệu Nông nghiệp tỉnh Quảng Trị.
        </div>
    </div>
</footer>
<!-- End Footer -->
@code {
    [Parameter]
    public bool IsCenter { get; set; } = false;
    private string FullYear { get; set; } = DateTime.Now.Year.ToString();
}
